#!/bin/bash
# Двойной клик по этому файлу запускает программу на Mac.
# Если Mac ругается "неизвестный разработчик" — правый клик -> Открыть.

cd "$(dirname "$0")"

echo "============================================================"
echo "  Навигатор видения"
echo "============================================================"
echo

if ! command -v python3 >/dev/null 2>&1; then
    echo "[!] Python не найден."
    echo
    echo "Установи его командой:  xcode-select --install"
    echo "или скачай с python.org"
    echo
    read -p "Нажми Enter чтобы закрыть..."
    exit 1
fi

python3 start.py

echo
echo "============================================================"
read -p "Нажми Enter чтобы закрыть..."
